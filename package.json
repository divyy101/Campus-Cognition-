{
  "name": "campus-cognition",
  "version": "2.0.0",
  "description": "Campus Cognition — Intelligent Student Learning & Career Platform (MERN)",
  "main": "backend/src/server.js",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "backend:dev": "npm run dev --workspace=backend",
    "frontend": "npm run dev --workspace=frontend",
    "dev": "concurrently \"npm run backend:dev\" \"npm run frontend\"",
    "build": "npm run build --workspace=frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
