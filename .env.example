# Campus Cognition V2 — Environment Variables
# Copy this file to .env and fill in your values

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=generate-a-secure-random-key-here
PORT=5000

# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=campus_cognition

# Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# AI Provider Configuration
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=openai

# Live discovery data (Google Programmable Search JSON API)
# Create a restricted key and a search engine at https://programmablesearchengine.google.com/
# Without these values, the portal uses the built-in official-portal fallback.
GOOGLE_CSE_API_KEY=your-google-custom-search-api-key
GOOGLE_CSE_ID=your-custom-search-engine-id

# Email delivery (required for welcome and password-reset emails)
# For Gmail, use smtp.gmail.com and an app password rather than your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_FROM=Campus Cognition <your-email@example.com>
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-email-app-password
