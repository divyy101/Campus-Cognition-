# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here
DEBUG=False

# Campus AI Production Provider
CAMPUS_AI_API_KEY=your-campus-ai-api-key
CAMPUS_AI_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
CAMPUS_AI_MODEL=llama-3.3-70b-versatile

# Google OAuth & Gemini Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# MongoDB Atlas Configuration
MONGODB_URI=your-mongodb-connection-string
MONGODB_DB_NAME=campus_cognition

# AI Provider Configuration
AI_PRIMARY_PROVIDER=campus_ai
AI_FALLBACK_PROVIDER=gemini


# Server Configuration
PORT=5000
HOST=localhost

# App Configuration
MAX_CONTENT_LENGTH=734003200

# Session Configuration
SESSION_TYPE=filesystem

# Email Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-email@gmail.com
MAIL_FROM_NAME=Campus Cognition
MAIL_USE_TLS=true

FRONTEND_URL=http://localhost:5000
