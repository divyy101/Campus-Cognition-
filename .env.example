# Campus Cognition Environment Variables
# Copy this file to .env and fill in your values

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production
PORT=5000

# Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Live discovery data (Google Programmable Search JSON API)
# Create a restricted key and a search engine at https://programmablesearchengine.google.com/
# Without these values, the portal uses the built-in official-portal fallback.
GOOGLE_CSE_API_KEY=your-google-custom-search-api-key
GOOGLE_CSE_ID=your-custom-search-engine-id

# Email delivery (required for welcome and password-reset emails)
# For Gmail, use smtp.gmail.com and an app password rather than your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_FROM=Campus Cognition <your-email@example.com>
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-email-app-password

# Database Configuration
DATABASE_URL=sqlite:///database/campus_cognition.db

# Session Configuration
SESSION_TYPE=filesystem
